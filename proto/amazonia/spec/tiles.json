  "frontiers": {
    "_comment": [
      "How two terrains meet. reach = how far the edge terrain pushes in from",
      "the rim, in hex radii (the apothem is 0.866, so 0.35 is about a third of",
      "the cell and 0 means they meet exactly on the edge — which is what an",
      "interior seam always uses). band = how wide the crossover is: small is",
      "an abrupt beach, large a soft gradient. shore paints sand where the mix",
      "crosses half and half; warp wobbles the boundary so it is not a chord."
    ],
    "default": { "reach": 0.35, "band": 0.35, "warp": 0.12 },
    "river|jungle": {
